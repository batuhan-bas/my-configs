{
  "name": "@batuhan-bas/configs",
  "version": "2.0.0",
  "description": "Shared ESLint (flat config) and Prettier configs for TypeScript, React, Vue and Angular projects",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "prettier",
    "prettier-config",
    "typescript",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "angular"
  ],
  "homepage": "https://github.com/batuhan-bas/my-configs#readme",
  "bugs": {
    "url": "https://github.com/batuhan-bas/my-configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhan-bas/my-configs.git"
  },
  "license": "MIT",
  "author": "Batuhan Baş (https://github.com/batuhan-bas)",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.config.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/vue": "./eslint/vue.js",
    "./eslint/angular": "./eslint/angular.js",
    "./eslint/prettier": "./eslint/prettier.js",
    "./eslint/utils": "./eslint/utils.js",
    "./prettier": "./prettier.config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "eslint",
    "eslint.config.js",
    "prettier.config.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "changeset": "changeset",
    "release": "pnpm test && changeset publish"
  },
  "peerDependencies": {
    "@angular-eslint/eslint-plugin": ">=20",
    "@angular-eslint/eslint-plugin-template": ">=20",
    "@angular-eslint/template-parser": ">=20",
    "@eslint-react/eslint-plugin": "^5",
    "@eslint/js": "^10",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^10",
    "eslint-plugin-react-hooks": ">=5",
    "eslint-plugin-vue": "^9.28 || ^10",
    "prettier": "^3",
    "vue-eslint-parser": "^9.4 || ^10"
  },
  "peerDependenciesMeta": {
    "@angular-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin-template": {
      "optional": true
    },
    "@angular-eslint/template-parser": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "^5.24.8",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0"
  }
